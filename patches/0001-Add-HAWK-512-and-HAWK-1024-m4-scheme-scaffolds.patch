diff --git a/crypto_sign/hawk1024/m4/keygen.c b/crypto_sign/hawk1024/m4/keygen.c
new file mode 100644
index 0000000..9eefeb1
--- /dev/null
+++ b/crypto_sign/hawk1024/m4/keygen.c
@@ -0,0 +1,20 @@
+/*
+ * keygen.c — HAWK-1024 key generation (pqm4 m4 implementation).
+ *
+ * Strategy:
+ *   1. Sample (f, g) using NTRUgen (Pornin, eprint 2025/1239); the portable
+ *      C is reused unchanged, with M4 inline assembly grafted into the
+ *      recursive base case.
+ *   2. NTRU-solve to get (F, G).
+ *   3. Compute the HAWK public key (q00, q01) in Plantard-NTT domain.
+ *   4. Encode pk = (q00, q01); sk = compressed (f, g, F, G).
+ */
+
+#include "api.h"
+#include "params.h"
+
+int crypto_sign_keypair(unsigned char *pk, unsigned char *sk) {
+    (void)pk;
+    (void)sk;
+    return -1;
+}
