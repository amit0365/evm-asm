+uint32_t stats_compute_w_err_lim1 = 0;
+uint32_t stats_compute_w_err_lim2 = 0;
+uint32_t stats_compute_w_err_lim3 = 0;
+uint32_t stats_compute_w_err_norm = 0;
+uint32_t stats_compute_w_success = 0;
