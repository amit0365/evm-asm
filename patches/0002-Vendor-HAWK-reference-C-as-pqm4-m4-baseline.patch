+mp_mkigm(unsigned logn, uint32_t *restrict igm,
+	uint32_t ig, uint32_t p, uint32_t p0i)
+{
+	size_t n = (size_t)1 << logn;
+
+	for (unsigned j = logn; j < 10; j ++) {
+		ig = mp_montymul(ig, ig, p, p0i);
+	}
+
+	unsigned k = 10 - logn;
+	uint32_t x2 = mp_hR(p);
+	size_t u = 0;
+	for (;;) {
+		size_t v = REV10[u << k];
+		igm[v] = x2;
+		u ++;
+		if (u >= n) {
+			break;
+		}
+		x2 = mp_montymul(x2, ig, p, p0i);
+	}
+}
