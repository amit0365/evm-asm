+shake_extract(shake_context *sc, void *out, size_t len)
+{
+	size_t dptr, rate;
+	uint8_t *buf;
+
+	dptr = sc->dptr;
+	rate = sc->rate;
+	buf = out;
+	while (len > 0) {
+		size_t clen;
+
+		if (dptr == rate) {
+			process_block(sc->A);
+			dptr = 0;
+		}
+		clen = rate - dptr;
+		if (clen > len) {
+			clen = len;
+		}
+		len -= clen;
+		while (clen -- > 0) {
