+static inline fxr
+fxr_div2e(fxr x, unsigned n)
+{
+	x.v += (((uint64_t)1 << n) >> 1);
+	x.v = (uint64_t)(*(int64_t *)&x.v >> n);
+	return x;
+}
+
+static inline fxr
+fxr_mul2e(fxr x, unsigned n)
+{
+	x.v <<= n;
+	return x;
+}
