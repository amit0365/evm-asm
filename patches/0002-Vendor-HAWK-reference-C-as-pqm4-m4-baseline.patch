+/* see ng_inner.h */
+void
+vect_FFT(unsigned logn, fxr *f)
+{
+	size_t hn = (size_t)1 << (logn - 1);
+	size_t t = hn;
+	for (unsigned lm = 1; lm < logn; lm ++) {
+		size_t m = (size_t)1 << lm;
+		size_t ht = t >> 1;
+		size_t j0 = 0;
+		size_t hm = m >> 1;
+		for (size_t i = 0; i < hm; i ++) {
+			fxc s = GM_TAB[m + i];
+			for (size_t j = j0; j < j0 + ht; j ++) {
+				fxc x, y;
+				x.re = f[j];
+				x.im = f[j + hn];
+				y.re = f[j + ht];
+				y.im = f[j + ht + hn];
+				y = fxc_mul(s, y);
+				fxc z1 = fxc_add(x, y);
+				f[j] = z1.re;
+				f[j + hn] = z1.im;
+				fxc z2 = fxc_sub(x, y);
+				f[j + ht] = z2.re;
+				f[j + ht + hn] = z2.im;
+			}
+			j0 += t;
+		}
+		t = ht;
+	}
+}
