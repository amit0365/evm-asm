+	"@ A[15] and A[16]\n\t"
+	"adds	r0, #24\n\t"
+	"ldm	r0!, { r5, r6, r7, r8 }\n\t"
+	"eors	r3, r5, r10\n\t"
+	"eors	r4, r6, r11\n\t"
