+static unsigned
+parity(unsigned logn, int8_t *f)
+{
+	size_t n = (size_t)1 << logn;
+	unsigned pp = 0;
+	for (size_t u = 0; u < n; u ++) {
+		pp += *(uint8_t *)&f[u];
+	}
+	return pp & 1;
