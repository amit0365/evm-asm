+
+/* see sha3.h */
+void
+sha3_close(sha3_context *sc, void *out)
+{
+	unsigned v;
+	uint8_t *buf;
+	size_t u, len;
+
+	/*
+	 * Apply padding. It differs from the SHAKE padding in that
+	 * we append '01', not '1111'.
