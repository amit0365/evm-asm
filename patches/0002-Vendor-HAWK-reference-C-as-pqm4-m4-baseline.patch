+/* see ng_inner.h */
+void
+mp_mkgm(unsigned logn, uint32_t *restrict gm,
+	uint32_t g, uint32_t p, uint32_t p0i)
+{
+	size_t n = (size_t)1 << logn;
+
+	for (unsigned j = logn; j < 10; j ++) {
+		g = mp_montymul(g, g, p, p0i);
+	}
+
+	unsigned k = 10 - logn;
+	uint32_t x1 = mp_R(p);
+	size_t u = 0;
+	for (;;) {
+		size_t v = REV10[u << k];
+		gm[v] = x1;
+		u ++;
+		if (u >= n) {
+			break;
+		}
+		x1 = mp_montymul(x1, g, p, p0i);
+	}
+}
