+/* see ng_inner.h */
+void
+mp_mkgm7(uint32_t *restrict gm, uint32_t g, uint32_t p, uint32_t p0i)
+{
+	size_t n = 128;
+	unsigned k = 3;
+	uint32_t x1 = mp_R(p);
+	for (size_t u = 0; u < n; u ++) {
+		size_t v = REV10[u << k];
+		gm[v] = x1;
+		x1 = mp_montymul(x1, g, p, p0i);
+	}
+}
