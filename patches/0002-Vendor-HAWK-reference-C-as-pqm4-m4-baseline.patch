+	/*
+	 * Write output. Output length (in bytes) is obtained from the rate.
+	 */
+	buf = out;
+	len = (200 - sc->rate) >> 1;
+	for (u = 0; u < len; u ++) {
+		buf[u] = (uint8_t)(sc->A[u >> 3] >> ((u & 7) << 3));
+	}
+}
