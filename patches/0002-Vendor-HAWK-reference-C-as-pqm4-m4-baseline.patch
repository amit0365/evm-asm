+	sc->A[v >> 3] ^= (uint64_t)0x1F << ((v & 7) << 3);
+	v = (unsigned)sc->rate - 1;
+	sc->A[v >> 3] ^= (uint64_t)0x80 << ((v & 7) << 3);
+	sc->dptr = sc->rate;
+}
