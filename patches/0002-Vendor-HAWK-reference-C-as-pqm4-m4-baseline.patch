+
+/* see sha3.h */
+void
+shake_inject(shake_context *sc, const void *in, size_t len)
+{
+	size_t dptr, rate;
+	const uint8_t *buf;
+
+	dptr = sc->dptr;
+	rate = sc->rate;
+	buf = in;
+	while (len > 0) {
+		size_t clen, u;
+
+		clen = rate - dptr;
+		if (clen > len) {
+			clen = len;
+		}
+		for (u = 0; u < clen; u ++) {
+			size_t v;
+
+			v = u + dptr;
+			sc->A[v >> 3] ^= (uint64_t)buf[u] << ((v & 7) << 3);
+		}
+		dptr += clen;
+		buf += clen;
+		len -= clen;
+		if (dptr == rate) {
+			process_block(sc->A);
+			dptr = 0;
+		}
+	}
+	sc->dptr = (unsigned)dptr;
